{
  "name": "immersive-translator",
  "version": "1.0.0",
  "description": "Test suite for immersive-translator",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:background": "jest tests/background.test.js",
    "test:content": "jest tests/content.test.js",
    "test:popup": "jest tests/popup.test.js",
    "test:pdf": "jest tests/pdf.test.js",
    "test:epub": "jest tests/epub.test.js",
    "test:img": "jest tests/img.test.js",
    "test:yt": "jest tests/youtube.test.js",
    "lint": "eslint *.js",
    "build": "echo 'Building extension...'",
    "package": "cd .. && zip -r tests/immersive-translator.zip manifest.json popup.html popup.js engines.js content.js content.css content-detector.js site-patches.js custom-css.js background.js meeting-translator.js speech-translator.js manga-translator.js youtube-translator.js netflix-translator.js pdf-viewer.html pdf-viewer.js epub-viewer.html epub-translator.js img-viewer.html img-translator.js document-translator.html lib/ icons/ README.md"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.1.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "html", "lcov"],
    "collectCoverageFrom": ["../*.js", "!../lib/**", "!../tests/coverage/**", "!**/node_modules/**"],
    "testMatch": ["**/tests/**/*.test.js"],
    "setupFilesAfterEnv": ["<rootDir>/setup.js"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}