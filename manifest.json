{
  "manifest_version": 3,
  "name": "immersive-translator",
  "version": "1.1.0",
  "description": "沉浸式翻译，双语对照网页翻译、PDF/EPUB/图片翻译、视频字幕翻译、多引擎自动降级",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engines.js", "content-detector.js", "site-patches.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "pdf-viewer.html", "epub-viewer.html", "img-viewer.html", "document-translator.html", "lib/*", "engines.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
